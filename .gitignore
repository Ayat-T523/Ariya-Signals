# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
# Icon\r (below) is the standard GitHub-template macOS custom-folder-icon rule —
# a literal file named "Icon" + a carriage return. The redundant `Icon?` variant
# that used to sit here matched more broadly than intended: with core.ignorecase
# (the Windows/macOS default), `?` (any one character) made it match "icons" too,
# silently swallowing every path under src/components/animate-ui/icons/ from the
# InForm rebrand commit onward. Icon\r alone covers the real intent without that
# collision — verified it does not match a directory literally named "icons".
Icon\r
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Environment files — never commit real values
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local

# Impeccable — per-developer overrides and local runtime cache stay local;
# .impeccable/config.json (shared detector ignores) is tracked.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/critique/
.impeccable/live/

# Supabase CLI local state (project ref, cached versions) — machine-specific
supabase/.temp/
