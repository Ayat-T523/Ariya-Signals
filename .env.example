# ── Auth mode (Frontend Step 3.5) ──────────────────────────────────────────────
# 'local' (default, or unset) — explicit local-development session, no
#   credentials, no backend required. See src/context/AuthContext.tsx.
# 'http'  — the future seam for POST /api/auth/login, GET /api/auth/me, etc.
#   Not implemented yet — selecting it shows a clear configuration error on
#   /sign-in instead of silently behaving like 'local'.
VITE_AUTH_MODE=local

# ── Supabase (optional — product-data queries only, not auth) ─────────────────
# No longer the target architecture (a future Ariya HTTP API replaces it —
# see this step's checkpoint) and NOT required for the app to run: every
# query in src/lib/db/index.ts degrades gracefully to empty/fixture data when
# these are unset. Only set them to exercise the still-live legacy product-data
# path (trials, financials, signals, etc.) ahead of that API existing.
# Get from: https://supabase.com/dashboard → project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key — server-side scripts and Edge Functions only. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Ingest scripts ────────────────────────────────────────────────────────────
SUPABASE_ACCESS_TOKEN=    # Supabase CLI personal access token (for Edge Function deploys)
INGEST_SECRET=            # Header auth for /api/ingest/* endpoints
FIRECRAWL_API_KEY=        # firecrawl.dev API key (scraping scripts)

# ── PostHog — internal analytics only. DO NOT set on client-facing Vercel deployments.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_IS_INTERNAL=       # Set to "true" for internal team members to filter from dashboards
SLACK_FEEDBACK_WEBHOOK_URL=   # Slack incoming webhook URL — feedback submissions are posted here

# ── Syncfusion licence (suppresses watermark) ─────────────────────────────────
# Free community licence: https://www.syncfusion.com/sales/communitylicense
VITE_SYNCFUSION_KEY=

# ── Ollama — local LLM for ingestion synthesis (Phase 2.2) ───────────────────
# Local server, no API key needed: install from ollama.com, run `ollama pull
# llama3.1`, leave the Ollama app / `ollama serve` running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Ollama — client-side (Ask InForm modal) ──────────────────────────────────
# Same local Ollama install as above, but read by the browser bundle (needs
# the VITE_ prefix — Vite doesn't expose unprefixed env vars to client code).
# Only reachable when the browser and the Ollama server are on the same
# machine/network -- fine for local dev, not for a deployed build talking to
# someone else's laptop. Defaults match the unprefixed vars above if unset.
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1
